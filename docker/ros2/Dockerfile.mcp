# UNTRUSTED third-party code: robotmcp/ros-mcp-server, built from a pinned commit.
# Reviewed commit (HEAD of main on 2026-10-18, v3.1.2). Source-reviewed, see docs/ros2-adapter-design.md.
FROM python:3.12-slim
ARG ROS_MCP_SHA=476591ac058f58cae810cc775e50b51f8d3d757c
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0t64 iputils-ping \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir \
      "https://github.com/robotmcp/ros-mcp-server/archive/${ROS_MCP_SHA}.tar.gz" \
 && useradd --create-home --shell /usr/sbin/nologin mcpuser
USER mcpuser
WORKDIR /home/mcpuser
EXPOSE 9000
ENTRYPOINT ["ros-mcp", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "9000"]
